<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ebot_description</name>
  <version>2.0.0</version>
  <description>
    eBot mobile base for the e-Yantra StrataCobot task: the model, its sensors and
    the launch file that spawns it into a running Gazebo world.
  </description>
  <maintainer email="helpdesk@e-yantra.org">e-Yantra</maintainer>
  <author>Ajinkya Naik</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
