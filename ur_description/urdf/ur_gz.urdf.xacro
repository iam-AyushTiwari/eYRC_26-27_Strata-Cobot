<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur7e">
  <xacro:arg name="name" default="ur7e" />

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/ros2_control_gz.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/ur_end_effector_sensor.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/ur_link_contact_sensors.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/realsense2.urdf.xacro" />

  <xacro:arg name="ur_type" default="ur7e" />

  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="transmission_hw_interface" default="" />
  <xacro:arg name="safety_limits" default="false" />
  <xacro:arg name="safety_pos_margin" default="0.15" />
  <xacro:arg name="safety_k_position" default="20" />

  <xacro:arg name="simulation_controllers"
    default="$(find ur_description)/config/ur_controllers.yaml" />

  <xacro:arg name="end_effector_force_sensor" default="true" />

  <xacro:arg name="magnet" default="true" />

  <xacro:arg name="realsense" default="true" />

  <xacro:arg name="link_contact_sensors" default="true" />

  <xacro:arg name="force_abs_paths" default="true" />

  <xacro:arg name="initial_positions_file"
    default="$(find ur_description)/config/initial_positions.yaml" />

  <xacro:arg name="mount_x" default="-0.597278" />
  <xacro:arg name="mount_y" default="1.8653" />
  <xacro:arg name="mount_z" default="0.8825" />
  <xacro:arg name="mount_roll" default="0" />
  <xacro:arg name="mount_pitch" default="0" />
  <xacro:arg name="mount_yaw" default="0" />

  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)" />

  <link name="world" />

  <joint name="world-arm_mount" type="fixed">
    <parent link="world" />
    <child link="arm_mount" />
    <origin xyz="$(arg mount_x) $(arg mount_y) $(arg mount_z)"
      rpy="$(arg mount_roll) $(arg mount_pitch) $(arg mount_yaw)" />
  </joint>

  <link name="arm_mount" />

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="arm_mount"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="$(arg force_abs_paths)"
  >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <link name="$(arg tf_prefix)arm_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find eyantra_kepler_colony)/models/arm_base/meshes/arm_base.glb" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0013 0.0064" rpy="0 0 0" />
      <geometry>
        <box size="0.655 0.640 0.5857" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.0013 0.0064" rpy="0 0 0" />
      <mass value="60.0" />
      <inertia ixx="3.76322" ixy="0.0" ixz="0.0" iyy="3.86035" iyz="0.0" izz="4.19313" />
    </inertial>
  </link>

  <joint name="$(arg tf_prefix)arm_base_joint" type="fixed">
    <parent link="arm_mount" />
    <child link="$(arg tf_prefix)arm_base" />
    <origin xyz="-0.195 0 -0.23" rpy="${pi/2} 0 ${-pi/2}" />
  </joint>

  <xacro:ur_gz_ros2_control
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    simulation_controllers="$(arg simulation_controllers)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
  />

  <xacro:if value="$(arg link_contact_sensors)">
    <xacro:ur_link_contact_sensors
      tf_prefix="$(arg tf_prefix)"
      include_end_effector="$(arg end_effector_force_sensor)"
    />
  </xacro:if>

  <xacro:if value="$(arg end_effector_force_sensor)">
    <xacro:ur_end_effector_sensor tf_prefix="$(arg tf_prefix)"
      force_abs_paths="$(arg force_abs_paths)" />
  </xacro:if>

  <xacro:if value="$(arg magnet)">
    <gazebo>
      <plugin filename="magnet_system" name="stratacobot::MagnetSystem" />
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg realsense)">
    <xacro:realsense2_camera name="camera" parent="base_link" tf_prefix="$(arg tf_prefix)">
      <origin xyz="-1.152 -0.02 1.2379" rpy="0.0 0.8342674 -0.0015926535897929917" />
    </xacro:realsense2_camera>
  </xacro:if>
</robot>