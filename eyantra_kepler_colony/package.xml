<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eyantra_kepler_colony</name>
  <version>2.0.0</version>
  <description>
    Gazebo Harmonic simulation of the Kepler colony mining arena: the SDF world plus
    its models and meshes, the arena world plugin, and the Task 2 launch files: the arm
    and its ores (task2a), and the eBot on a rock map (task2b).
  </description>
  <maintainer email="helpdesk@e-yantra.org">e-Yantra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <exec_depend>ebot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>gz_sim_vendor</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>openssl</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
